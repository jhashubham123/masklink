# Supabase: Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password for the dashboard (use a long random string)
ADMIN_TOKEN=change-me-to-a-long-random-string

# Secret that your affiliate network must include in postback URLs
POSTBACK_SECRET=change-me-too

# Random string used to hash visitor IPs (never stored raw)
IP_SALT=another-random-string

# Query param used to pass the click id if the affiliate URL has no {click_id} macro
CLICK_ID_PARAM=sub1
